# Copia questo file in ".env.local" e inserisci le tue chiavi.
# ".env.local" è ignorato da git e non finirà mai su GitHub.
#
# Servono solo le chiavi dei provider che usi davvero.

# Google Gemini — necessaria per la voce in tempo reale (Gemini Live)
GEMINI_API_KEY=

# Opzionali: altri motori testuali
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# xKiro — gateway: una sola chiave per i modelli di più fornitori
# (https://xkiro.com/dashboard/api/keys)
XKIRO_API_KEY=
